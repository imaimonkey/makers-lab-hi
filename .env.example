# 개발자 페이지에서 실제 AI를 사용할지 여부
VITE_LLM_USE_MOCK=false

# Gemini 또는 Potens 중 사용할 LLM 설정
# Gemini 발급: https://aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=여기에_Gemini_API_Key

# Potens를 사용할 때만 입력합니다. 입력하면 현재 서버 프록시가 Potens를 우선 사용합니다.
# Potens 발급: https://ai.potens.ai/
POTENS_MODEL=claude-4-6-sonnet
POTENS_API_KEY=여기에_Potens_API_Key

# 개발자 페이지에서 util-1 뉴스 수집 패널과 시스템 프롬프트 UI를 표시합니다.
VITE_SHOW_DEVELOPER_NEWS_PANEL=true
VITE_SHOW_SYSTEM_PROMPT_UI=true

# 네이버 뉴스 API 발급: https://developers.naver.com/apps/#/register
# 입력하면 개발자 UI의 빈 입력란에서도 서버가 이 값을 사용합니다.
NAVER_CLIENT_ID=여기에_Naver_Client_ID
NAVER_CLIENT_SECRET=여기에_Naver_Client_Secret
LAW_OPEN_API_KEY=여기에_국가법령정보_API_인증키
